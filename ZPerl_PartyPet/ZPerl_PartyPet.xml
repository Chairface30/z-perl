<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

	<Script file="ZPerl_PartyPet.lua"/>

	<Button name="XPerl_Party_Pet_FrameTemplate" inherits="SecureUnitButtonTemplate" frameStrata="LOW" hidden="true" movable="false" virtual="true">
		<Size x="80" y="55"/>

		<Scripts>
			<OnLoad>
				self:RegisterForClicks("AnyUp")
				XPerl_Party_Pet_OnLoad(self)
				self:SetScript("OnEnter", ZPerl_Unit_OnEnter)
				self:SetScript("OnLeave", ZPerl_Unit_OnLeave)
			</OnLoad>
		</Scripts>

		<Frames>
			<Button name="$parentnameFrame" inherits="XPerlBackdropTemplate,SecureUnitButtonTemplate">
				<KeyValues>
					<KeyValue key="backdropInfo" value="XPerl_Frame_Backdrop_32_16_4444" type="global"/>
				</KeyValues>
				<Scripts>
					<OnLoad>
						self:OnBackdropLoaded()
						self:RegisterForClicks("AnyUp")
						XPerl_RegisterUnitText(_G[self:GetName().."text"])
						XPerl_RegisterUnitText(_G[self:GetName().."level"])
						self:SetScript("OnEnter", function(self) ZPerl_Unit_OnEnter(self:GetParent()) end)
						self:SetScript("OnLeave", function(self) ZPerl_Unit_OnLeave(self:GetParent()) end)
					</OnLoad>
				</Scripts>
				<Size x="80" y="20"/>
				<Anchors>
					<Anchor point="TOPLEFT"/>
				</Anchors>
				<Layers>
					<Layer level="OVERLAY">
						<Texture name="$parentcombatIcon" file="Interface\CharacterFrame\UI-StateIcon" hidden="true">
							<Size x="32" y="31"/>
							<Anchors>
								<Anchor point="RIGHT" relativePoint="RIGHT"/>
							</Anchors>
						</Texture>

						<Texture name="$parentwarningIcon" file="Interface\Minimap\Ping\ping6" alphaMode="ADD" hidden="true">
							<Size x="32" y="31"/>
							<Anchors>
								<Anchor point="TOP" relativePoint="TOP" x="0" y="2"/>
							</Anchors>
						</Texture>

						<FontString name="$parenttext" inherits="GameFontNormalSmall" justifyH="LEFT">
							<Anchors>
								<Anchor point="TOPLEFT" x="5" y="0"/>
								<Anchor point="BOTTOMRIGHT" x="0" y="2"/>
							</Anchors>
						</FontString>

						<FontString name="$parentlevel" inherits="GameFontNormalSmall" justifyH="RIGHT">
							<Anchors>
								<Anchor point="TOPLEFT"/>
								<Anchor point="BOTTOMRIGHT" x="-5" y="2"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Button>

			<Frame name="$parentstatsFrame" inherits="XPerlBackdropTemplate,XPerl_Stats_Template">
				<Size x="80" y="33"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$parentnameFrame" x="0" y="4"/>
				</Anchors>
			</Frame>

			<Frame name="$parenthighlight" inherits="XPerl_HighlightTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentnameFrame"/>
					<Anchor point="BOTTOMRIGHT" relativeTo="$parentstatsFrame"/>
				</Anchors>
			</Frame>

			<Frame name="$parentbuffFrame">
				<Size x="170" y="20"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$parentstatsFrame" x="5" y="0"/>
				</Anchors>
			</Frame>

			<Frame name="$parentdebuffFrame">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentbuffFrame"/>
					<Anchor point="BOTTOMRIGHT" relativeTo="$parentbuffFrame"/>
				</Anchors>
			</Frame>
		</Frames>
	</Button>

	<Button name="XPerl_partypet1" inherits="XPerl_Party_Pet_FrameTemplate" parent="XPerl_party1" id="1">
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="XPerl_party1statsFrame" relativePoint="TOPRIGHT" x="-2" y="0"/>
		</Anchors>
	</Button>
	<Button name="XPerl_partypet2" inherits="XPerl_Party_Pet_FrameTemplate" parent="XPerl_party2" id="2">
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="XPerl_party2statsFrame" relativePoint="TOPRIGHT" x="-2" y="0"/>
		</Anchors>
	</Button>
	<Button name="XPerl_partypet3" inherits="XPerl_Party_Pet_FrameTemplate" parent="XPerl_party3" id="3">
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="XPerl_party3statsFrame" relativePoint="TOPRIGHT" x="-2" y="0"/>
		</Anchors>
	</Button>
	<Button name="XPerl_partypet4" inherits="XPerl_Party_Pet_FrameTemplate" parent="XPerl_party4" id="4">
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="XPerl_party4statsFrame" relativePoint="TOPRIGHT" x="-2" y="0"/>
		</Anchors>
	</Button>
	<Button name="XPerl_partypet5" inherits="XPerl_Party_Pet_FrameTemplate" parent="XPerl_party5" id="5">
		<Anchors>
			<Anchor point="TOPLEFT" relativeTo="XPerl_party4statsFrame" relativePoint="TOPRIGHT" x="-2" y="0"/>
		</Anchors>
	</Button>

	<Frame name="XPerl_Party_Pet_EventFrame">
		<Scripts>
			<OnLoad function="XPerl_Party_Pet_OnLoadEvents"/>
		</Scripts>
	</Frame>
</Ui>
