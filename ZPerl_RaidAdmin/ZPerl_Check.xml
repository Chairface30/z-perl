		</KeyValues>
		<Scripts>
			<OnLoad>
				self:OnBackdropLoaded()
				XPerl_CheckOnLoad(self)
			</OnLoad>
			<OnEnter>
				XPerl_Check.forcedOpen = nil
			</OnEnter>
			<OnDragStart>
				if (not ZPerl_Admin.CheckPinned or (IsAltKeyDown() and IsControlKeyDown() and IsShiftKeyDown())) then
					XPerl_CheckAnchor:StartMoving()
				end
			</OnDragStart>
			<OnDragStop>
				XPerl_CheckAnchor:StopMovingOrSizing()
				if (XPerl_SavePosition) then
					XPerl_SavePosition(XPerl_CheckAnchor)
				end
			</OnDragStop>
		</Scripts>
		<Anchors>
			<Anchor point="TOPLEFT"/>
		</Anchors>
		<Size x="500" y="240"/>
		<Frames>
			<Frame name="$parentTitleBar">
				<Scripts>
					<OnEnter>
						XPerl_Check.forcedOpen = nil
						XPerl_Check_Expand()
						XPerl_Check_ItemsChanged()
					</OnEnter>
					<OnLoad>
						self:RegisterForDrag("LeftButton")
					</OnLoad>
					<OnDragStart>
						if (not ZPerl_Admin.CheckPinned or (IsAltKeyDown() and IsControlKeyDown() and IsShiftKeyDown())) then
							XPerl_CheckAnchor:StartMoving()
						end
