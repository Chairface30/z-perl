			<CheckButton name="$parentTick" inherits="UICheckButtonTemplate">
				<Size x="18" y="18"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="-3" y="2"/>
				</Anchors>
				<Scripts>
					<OnClick>
						XPerl_Check_OnClickTick(self)
						XPerl_Check_OnClickItem(arg1)
					</OnClick>
					<OnEnter>
						self:GetParent():LockHighlight()
						XPerl_Check_OnEnter(self)
					</OnEnter>
					<OnLeave>
						GameTooltip:Hide()
						for k,v in pairs(ZPerl_CheckItems) do
							if (v.link == _G[self:GetParent():GetName().."Name"]:GetText()) then
								if (not v.selected) then
									self:GetParent():UnlockHighlight()
								end
							end
						end
					</OnLeave>
				</Scripts>
			</CheckButton>
		</Frames>
